###############################################################################
#####  SOAP sources                                                       ##### 
###############################################################################
EmisSOAP_Total     SOAP   -1     -1  -1   3   kg/m2/s  SOAP_emission_flux_from_all_sectors
EmisSOAP_Aircraft  SOAP   0      20  -1   3   kg/m2/s  SOAP_emission_flux_from_aircraft
EmisSOAP_Anthro    SOAP   0      1   -1   3   kg/m2/s  SOAP_emission_flux_from_anthropogenic
EmisSOAP_Biogenic  SOAP   0      3   -1   2   kg/m2/s  SOAP_emission_flux_from_monoterpenes
EmisSOAP_BioBurn   SOAP   112    -1  -1   2   kg/m2/s  SOAP_emission_flux_from_biomass_burning
EmisSOAP_Ship      SOAP   0      10  -1   2   kg/m2/s  SOAP_emission_flux_from_ships

###############################################################################
#####  SOAS sources                                                       ##### 
###############################################################################
EmisSOAS_Biogenic  SOAS   0      3   -1   2   kg/m2/s  SOAS_emission_flux_from_biogenic_sources

# BrC-family source diagnostics: paired 2-D columns and 3-D profiles.
# The BioBurn defaults below select native GFAS (112/-1/-1).  To select GFED,
# FINNv25 injection, FINNv25 surface, or QFED direct rows, use respectively
# 111/-1/-1, 165/-1/-1, 0/5/3, or 0/5/2.  Run-directory creation does not
# rewrite these selectors; edit them manually when changing inventories.
EmisFSOAP_BioBurn FSOAP 112 -1 -1 2 kg/m2/s FSOAP_emission_flux_from_biomass_burning
EmisFSOAP_BioBurn3D FSOAP 112 -1 -1 3 kg/m2/s FSOAP_emission_profile_from_biomass_burning
EmisDBRCPOA_BioBurn DBRCPOA 112 -1 -1 2 kg/m2/s DBRCPOA_emission_flux_from_biomass_burning
EmisDBRCPOA_BioBurn3D DBRCPOA 112 -1 -1 3 kg/m2/s DBRCPOA_emission_profile_from_biomass_burning
EmisNPBRCPOA_BioBurn NPBRCPOA 112 -1 -1 2 kg/m2/s NPBRCPOA_emission_flux_from_biomass_burning
EmisNPBRCPOA_BioBurn3D NPBRCPOA 112 -1 -1 3 kg/m2/s NPBRCPOA_emission_profile_from_biomass_burning
EmisPBRCPOA_BioBurn PBRCPOA 112 -1 -1 2 kg/m2/s PBRCPOA_emission_flux_from_biomass_burning
EmisPBRCPOA_BioBurn3D PBRCPOA 112 -1 -1 3 kg/m2/s PBRCPOA_emission_profile_from_biomass_burning
EmisFSOAP_Total FSOAP -1 -1 -1 3 kg/m2/s FSOAP_emission_flux_from_all_sources
EmisDBRCPOA_Total DBRCPOA -1 -1 -1 3 kg/m2/s DBRCPOA_emission_flux_from_all_sources
EmisNPBRCPOA_Total NPBRCPOA -1 -1 -1 3 kg/m2/s NPBRCPOA_emission_flux_from_all_sources
EmisPBRCPOA_Total PBRCPOA -1 -1 -1 3 kg/m2/s PBRCPOA_emission_flux_from_all_sources
EmisFSOAP_TotalColumn FSOAP -1 -1 -1 2 kg/m2/s FSOAP_column_emission_flux_from_all_sources
EmisDBRCPOA_TotalColumn DBRCPOA -1 -1 -1 2 kg/m2/s DBRCPOA_column_emission_flux_from_all_sources
EmisNPBRCPOA_TotalColumn NPBRCPOA -1 -1 -1 2 kg/m2/s NPBRCPOA_column_emission_flux_from_all_sources
EmisPBRCPOA_TotalColumn PBRCPOA -1 -1 -1 2 kg/m2/s PBRCPOA_column_emission_flux_from_all_sources
