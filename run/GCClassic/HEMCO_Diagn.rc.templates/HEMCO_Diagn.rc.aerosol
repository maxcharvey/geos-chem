#InvGFAS_NPBRCPOA NPBRCPOA 112 -1 -1 3 kg/m2/s NPBRCPOA_emission_flux_from_GFAS_variable_height
#InvGFAS_PBRCPOA PBRCPOA 112 -1 -1 3 kg/m2/s PBRCPOA_emission_flux_from_GFAS_variable_height
