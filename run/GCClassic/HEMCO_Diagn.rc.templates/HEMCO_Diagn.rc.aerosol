#InvFINNv25Inject_BCPO BCPO 165 -1 -1 3 kg/m2/s BCPO_emission_flux_from_FINNv25_injection
#InvFINNv25Inject_OCPI OCPI 165 -1 -1 3 kg/m2/s OCPI_emission_flux_from_FINNv25_injection
#InvFINNv25Inject_OCPO OCPO 165 -1 -1 3 kg/m2/s OCPO_emission_flux_from_FINNv25_injection
